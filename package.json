{
  "name": "menyu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,realtime,edge-runtime,logflare,vector,supavisor,imgproxy,postgres-meta",
    "db:reset": "supabase db reset && npm run seed",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "plans:sql": "tsx scripts/plans-sql.ts",
    "admin:add": "tsx --conditions=react-server --env-file=.env.local scripts/add-admin.ts",
    "i18n:sync": "tsx scripts/sync-lg.ts",
    "seed:demo": "tsx --conditions=react-server --env-file=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsqr": "^1.4.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
