# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables. Never commit real values.

# Public (shipped to the browser) ------------------------------------------
# The live domain. QR codes encode it, so set the final domain BEFORE
# printing any table cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase "publishable" key (safe in the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only ----------------------------------------------------------------
# Supabase "secret" key. Bypasses row-level security: server code only.
SUPABASE_SECRET_KEY=
# Secret for the Send SMS auth hook, format "v1,whsec_<base64>". The same
# value goes into Supabase (Authentication > Hooks > Send SMS).
SUPABASE_AUTH_HOOK_SEND_SMS_SECRET=

# SMS sign-in codes. "console" prints codes (development); "africastalking"
# sends them. Production must use africastalking.
SMS_PROVIDER=console
# Country codes that may receive SMS codes (comma separated). Uganda only by
# default, which blocks SMS-pumping fraud to premium numbers abroad.
SMS_ALLOWED_COUNTRY_CODES=256
# Local only: lets the console provider run under `next start`.
ALLOW_CONSOLE_SMS=

# Africa's Talking (https://account.africastalking.com). Use username
# "sandbox" with a sandbox key to test against their simulator.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Registered sender ID or short code (optional; leave empty to use the default).
AFRICASTALKING_SENDER_ID=

# Protects /api/cron/* (Vercel Cron sends it as a bearer token).
CRON_SECRET=

# Reading menus from photos (Claude API, https://console.anthropic.com).
# Without a key the photo import shows "Send it to us" instead.
ANTHROPIC_API_KEY=
# Optional: model and effort for reading menus. Defaults: claude-opus-5-5, medium.
MENU_IMPORT_MODEL=
MENU_IMPORT_EFFORT=
# Local only: "1" replaces the Claude call with a canned menu (tests, no key).
# Ignored unless Supabase runs on localhost, and always ignored on Vercel.
MENU_IMPORT_FAKE=
